{
  "_comment": "Bench utility: light the (already-flashed) LilyGo panel and hold power for ROI recalibration. No flash, no capture.",
  "device": "mcu-lilygo-tdisplay-s3-hil006",
  "uid": "lilygo-t-display-s321621634",
  "camera_url": "http://rpi-hil006:8080/",
  "window_minutes": 20,
  "skip_flash": true,
  "sequence": [
    {
      "step": "display_add",
      "interface": "i8080",
      "name": "tft-19-i8080",
      "driver": "ST7789",
      "data_pins": ["D39", "D40", "D41", "D42", "D45", "D46", "D47", "D48"],
      "cs": "D6",
      "dc": "D7",
      "rst": "D5",
      "wr": "D8",
      "rd": "D9",
      "backlight": "D38",
      "power": "D15",
      "width": 320,
      "height": 170,
      "rotation": 1,
      "text_size": 2,
      "status_bar": true,
      "settle_s": 5
    },
    {
      "step": "display_write",
      "name": "tft-19-i8080",
      "message": "LilyGo T-Display-S3\nWipperSnapper v2\nproto pins: wr/rd/bl/pwr\nHIL camera proof OK",
      "settle_s": 5
    }
  ]
}
